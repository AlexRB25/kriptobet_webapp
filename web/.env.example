# Copia este archivo como .env.local y rellénalo. En Vercel van las mismas variables.

# ── Supabase: Project Settings → API Keys ──
PB_SUPABASE_URL=
PB_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (solo servidor): con ella el servidor juega las rondas, acredita depósitos y liquida apuestas.
SUPABASE_SECRET_KEY=

# Dirección pública del sitio, sin diagonal final (https://tudominio.com). Vacía = la de la petición.
# NOWPayments necesita poder llegar a ella para avisar de los pagos (en local usa un túnel o el botón de la cartera).
SITE_URL=

# ── Depósitos en cripto: NOWPayments (https://nowpayments.io → Settings → API keys) ──
# Sin esta clave la cartera muestra "depósitos no activados".
NOWPAYMENTS_API_KEY=
# 1 = usar el entorno de pruebas (https://sandbox.nowpayments.io, con su propia API key).
NOWPAYMENTS_SANDBOX=

# ── Cuotas y resultados: The Odds API (https://the-odds-api.com) ──
ODDS_API_KEY=
# Ligas a ofrecer, separadas por comas (claves de la API). Vacío = Liga MX, Champions, Premier, LaLiga, NFL, NBA, MLB y NHL.
ODDS_SPORTS=
# Región de casas de apuestas de la que se toman las cuotas: eu, uk, us o au.
ODDS_REGIONS=eu
# Margen extra de la casa sobre la ganancia de cada cuota (0.05 = 5 %). Vacío = ninguno.
ODDS_MARGIN=

# Secreto de las tareas programadas (/api/cron/*). Vercel Cron lo envía solo si existe esta variable.
CRON_SECRET=

# 1 = modo demo: botón "Recargar saldo de prueba" en la cartera para probar sin cripto. QUÍTALO en producción.
PB_DEMO_MODE=

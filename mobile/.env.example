# Copia este archivo como .env.local y rellénalo.

# Supabase: Project Settings → API Keys. SOLO la clave publicable; la secreta nunca va en la app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dirección de la web (carpeta web/), sin diagonal final. La app la usa para el casino y los depósitos.
# En desarrollo con un teléfono real usa la IP de tu PC: http://192.168.1.50:3000
EXPO_PUBLIC_API_URL=
